ObjC.import('Foundation');
ObjC.import('AppKit');
// Diagnostic only — NOT shipped in the app. Run while music plays:
//   osascript -l JavaScript scripts/artwork-probe.jxa
// Finding so far: for Chrome sessions the artwork value is a FUNCTION
// (an ObjC block bridged as a JS function), but calling it directly
// fails from JXA ("Object is not a function") for both no-arg and
// size calls. The remaining JXA direction is the well-supported one:
// instead of calling a bridged block OUT, pass a real JS function IN
// as a completion handler and let the framework call it — then wait
// on the runloop for the callback. This probe tries that on both the
// dict block and the item's artwork accessor (with a size, and with
// a handler). Each attempt is guarded; a call that throws is
// reported, not fatal. If an attempt yields image bytes, that route
// is the fix.
function run() {
  try {
    var bundle = $.NSBundle.bundleWithPath('/System/Library/PrivateFrameworks/MediaRemote.framework/');
    // Zero-argument ObjC methods fire on bare property access.
    bundle.load;
    var MRNowPlayingRequest = $.NSClassFromString('MRNowPlayingRequest');
    if (!MRNowPlayingRequest) return JSON.stringify(null);
    var item = MRNowPlayingRequest.localNowPlayingItem;
    if (!item) return JSON.stringify(null);
    var info = item.nowPlayingInfo;
    if (!info) return JSON.stringify(null);
    function str(key) {
      var v = info.valueForKey(key);
      return v ? v.js : '';
    }
    var art = null;
    try { art = info.valueForKey('kMRMediaRemoteNowPlayingInfoArtwork'); } catch (e) {}
    function pngBase64(cgImage) {
      var rep = $.NSBitmapImageRep.alloc.initWithCGImage(cgImage);
      var data = rep.representationUsingTypeProperties(4, $.NSDictionary.dictionary);
      return data.base64EncodedStringWithOptions(0).js;
    }
    function tiffBase64(cgImage) {
      var img = $.NSImage.alloc.initWithCGImageSize(cgImage, { width: 600, height: 600 });
      var tiff = img.TIFFRepresentation;
      return tiff.base64EncodedStringWithOptions(0).js;
    }
    function imageBase64(value) {
      if (!value) return 'null-value';
      try { var b = value.base64EncodedStringWithOptions(0).js; if (b) return 'nsdata len ' + b.length; } catch (e) {}
      try { var b2 = pngBase64(value); if (b2) return 'png len ' + b2.length; } catch (e) {}
      try { var b3 = tiffBase64(value); if (b3) return 'tiff len ' + b3.length; } catch (e) {}
      return 'none';
    }
    function describeValue(value) {
      var d = {};
      try { d.typeofValue = typeof value; } catch (e) { d.typeofValue = 'error'; }
      try { d.string = value ? String(value).slice(0, 120) : 'null'; } catch (e) { d.string = 'error'; }
      d.converted = imageBase64(value);
      return d;
    }
    function waitRunloop(seconds) {
      // Let async callbacks fire: run the runloop briefly.
      try {
        $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(seconds));
      } catch (e) {}
    }
    var attempts = {};
    // A: item.artwork with a size (if it is an args-taking method
    // rather than the zero-arg accessor that returns the block).
    try {
      var rA = item.artwork({ width: 600, height: 600 });
      attempts.itemArtworkWithSize = describeValue(rA);
    } catch (e) { attempts.itemArtworkWithSize = { error: String(e) }; }
    // B: item.artwork with a completion handler + runloop wait.
    try {
      var capturedB = null;
      item.artwork(function (img) { capturedB = img; });
      waitRunloop(3);
      attempts.itemArtworkWithHandler = describeValue(capturedB);
    } catch (e) { attempts.itemArtworkWithHandler = { error: String(e) }; }
    // C: dict block with a completion handler + runloop wait.
    try {
      var capturedC = null;
      art(function (img) { capturedC = img; });
      waitRunloop(3);
      attempts.dictBlockWithHandler = describeValue(capturedC);
    } catch (e) { attempts.dictBlockWithHandler = { error: String(e) }; }
    return JSON.stringify({
      title: str('kMRMediaRemoteNowPlayingInfoTitle'),
      artist: str('kMRMediaRemoteNowPlayingInfoArtist'),
      artworkPresent: !!art,
      typeofArt: (function () { try { return typeof art; } catch (e) { return 'error'; } })(),
      typeofItemArtwork: (function () { try { return typeof item.artwork; } catch (e) { return 'error'; } })(),
      attempts: attempts
    });
  } catch (e) {
    return JSON.stringify({ error: String(e) });
  }
}
