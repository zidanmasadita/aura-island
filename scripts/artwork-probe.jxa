ObjC.import('Foundation');
ObjC.import('AppKit');
// Diagnostic only — NOT shipped in the app. Run while music plays:
//   osascript -l JavaScript scripts/artwork-probe.jxa
// Finding so far: the artwork value is a block that JXA cannot call
// in ANY form (no-arg, size, handler, via the dict or via the item
// accessor — all "Object is not a function"). The call-based path is
// therefore closed. This final probe dumps the ENTIRE nowPlayingInfo
// dictionary: every key, each value's type, and — for string values
// (a possible artwork URL) and NSData values — the content itself.
// No values are called, so nothing here can throw from invocation.
// If no key besides the block carries artwork, the system path via
// JXA is proven closed and only the Chrome extension's Media Session
// artwork URL remains.
function run() {
  try {
    var bundle = $.NSBundle.bundleWithPath('/System/Library/PrivateFrameworks/MediaRemote.framework/');
    // Zero-argument ObjC methods fire on bare property access.
    bundle.load;
    var MRNowPlayingRequest = $.NSClassFromString('MRNowPlayingRequest');
    if (!MRNowPlayingRequest) return JSON.stringify(null);
    var item = MRNowPlayingRequest.localNowPlayingItem;
    if (!item) return JSON.stringify(null);
    var info = item.nowPlayingInfo;
    if (!info) return JSON.stringify(null);
    var keys = [];
    try { keys = info.allKeys.js; } catch (e) { keys = ['allKeys-error: ' + String(e)]; }
    var entries = {};
    keys.forEach(function (key) {
      var entry = {};
      var value = null;
      try { value = info.valueForKey(key); } catch (e) { entry.error = 'valueForKey: ' + String(e); entries[key] = entry; return; }
      try { entry.typeofValue = typeof value; } catch (e) { entry.typeofValue = 'error'; }
      // Strings: print (truncated) — an artwork URL would show here.
      try {
        if (typeof value === 'string') entry.string = value.slice(0, 300);
      } catch (e) {}
      // NSData: base64 length only (bytes stay out of the output).
      try {
        if (value && typeof value.base64EncodedStringWithOptions === 'function') {
          var b = value.base64EncodedStringWithOptions(0).js;
          entry.nsdataLength = b ? b.length : 0;
        }
      } catch (e) {}
      // Numbers/booleans: print directly (tiny, safe).
      try {
        if (typeof value === 'number' || typeof value === 'boolean') entry.scalar = value;
      } catch (e) {}
      entries[key] = entry;
    });
    return JSON.stringify({
      title: (function () { try { var v = info.valueForKey('kMRMediaRemoteNowPlayingInfoTitle'); return v ? v.js : ''; } catch (e) { return ''; } })(),
      artist: (function () { try { var v = info.valueForKey('kMRMediaRemoteNowPlayingInfoArtist'); return v ? v.js : ''; } catch (e) { return ''; } })(),
      keys: keys,
      entries: entries
    });
  } catch (e) {
    return JSON.stringify({ error: String(e) });
  }
}
