ObjC.import('Foundation');
ObjC.import('AppKit');
// Diagnostic only — NOT shipped in the app. Run while music plays:
//   osascript -l JavaScript scripts/artwork-probe.jxa
// v6 listed the 13 stored keys — notably WITHOUT an Artwork key, but
// WITH artwork metadata: ArtworkIdentifier, ArtworkMIMEType,
// ArtworkDataHeight, ArtworkDataWidth. v6 also exposed a probe flaw:
// typeof on a RAW ObjC wrapper is "function" for EVERY type (even
// Title/Artist strings), so typeof alone cannot identify a value —
// the earlier "block" inference from typeof was unreliable. What v3/v4
// actually proved is narrower: the computed Artwork value is not
// callable, not NSData, not MPMediaItemArtwork, and its description
// throws. v7 therefore reports CONVERTED values (.js) instead of raw
// typeof: strings print (an artwork URL would show here in full),
// numbers print, NSData reports base64 length. The Artwork key itself
// (absent from allKeys but resolvable via valueForKey) is included
// as a 14th entry. No values are called.
function run() {
  try {
    var bundle = $.NSBundle.bundleWithPath('/System/Library/PrivateFrameworks/MediaRemote.framework/');
    // Zero-argument ObjC methods fire on bare property access.
    bundle.load;
    var MRNowPlayingRequest = $.NSClassFromString('MRNowPlayingRequest');
    if (!MRNowPlayingRequest) return JSON.stringify(null);
    var item = MRNowPlayingRequest.localNowPlayingItem;
    if (!item) return JSON.stringify(null);
    var info = item.nowPlayingInfo;
    if (!info) return JSON.stringify(null);
    // Keys as real JS strings (explicit per-element conversion).
    var keys = [];
    try {
      var raw = info.allKeys;
      var count = raw.count;
      for (var i = 0; i < count; i++) {
        var el = raw.objectAtIndex(i);
        var jsKey = null;
        try { jsKey = (el && typeof el.js !== 'undefined') ? el.js : String(el); } catch (e) { jsKey = 'key-error-' + i; }
        keys.push(jsKey);
      }
    } catch (e) { keys = ['allKeys-error: ' + String(e)]; }
    // The Artwork key is not stored but resolves via valueForKey —
    // include it explicitly so its converted value is reported too.
    keys.push('kMRMediaRemoteNowPlayingInfoArtwork');
    var entries = {};
    keys.forEach(function (key) {
      var entry = {};
      var value = null;
      try { value = info.valueForKey(key); } catch (e) { entry.error = 'valueForKey: ' + String(e); entries[key] = entry; return; }
      // Converted value: NSString -> JS string, NSNumber -> JS number.
      // NSData and exotic objects fail conversion (reported as such).
      var js = null;
      var jsError = false;
      try { js = value.js; } catch (e) { jsError = true; }
      try { entry.convertedType = jsError ? 'js-error' : (typeof js); } catch (e) { entry.convertedType = 'error'; }
      try {
        if (!jsError && typeof js === 'string') entry.string = js.slice(0, 1000);
        if (!jsError && typeof js === 'number') entry.number = js;
        if (!jsError && typeof js === 'boolean') entry.boolean = js;
      } catch (e) {}
      // NSData check (independent of conversion): base64 length only.
      try {
        if (value && typeof value.base64EncodedStringWithOptions === 'function') {
          var b = value.base64EncodedStringWithOptions(0).js;
          entry.nsdataLength = b ? b.length : 0;
        }
      } catch (e) {}
      entries[key] = entry;
    });
    return JSON.stringify({
      title: (function () { try { var v = info.valueForKey('kMRMediaRemoteNowPlayingInfoTitle'); return v ? v.js : ''; } catch (e) { return ''; } })(),
      artist: (function () { try { var v = info.valueForKey('kMRMediaRemoteNowPlayingInfoArtist'); return v ? v.js : ''; } catch (e) { return ''; } })(),
      keys: keys,
      entries: entries
    });
  } catch (e) {
    return JSON.stringify({ error: String(e) });
  }
}
