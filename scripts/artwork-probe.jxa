ObjC.import('Foundation');
ObjC.import('AppKit');
// Diagnostic only — NOT shipped in the app. Run while music plays:
//   osascript -l JavaScript scripts/artwork-probe.jxa
// Finding so far: for Chrome sessions the artwork value is a FUNCTION
// (typeofArt "function", String "[id nil]") — an ObjC block bridged
// as a JS function, i.e. a lazy artwork provider that must be CALLED.
// This probe calls it (no-arg, then with a size) and reports what each
// call returns and whether it converts to image bytes. If a call
// crashes the process (no JSON output at all), that itself says the
// block expects a completion handler — the next variant then waits
// on the runloop for the callback.
function run() {
  try {
    var bundle = $.NSBundle.bundleWithPath('/System/Library/PrivateFrameworks/MediaRemote.framework/');
    // Zero-argument ObjC methods fire on bare property access.
    bundle.load;
    var MRNowPlayingRequest = $.NSClassFromString('MRNowPlayingRequest');
    if (!MRNowPlayingRequest) return JSON.stringify(null);
    var item = MRNowPlayingRequest.localNowPlayingItem;
    if (!item) return JSON.stringify(null);
    var info = item.nowPlayingInfo;
    if (!info) return JSON.stringify(null);
    function str(key) {
      var v = info.valueForKey(key);
      return v ? v.js : '';
    }
    var art = null;
    try { art = info.valueForKey('kMRMediaRemoteNowPlayingInfoArtwork'); } catch (e) {}
    // Safe typeof probes on the item itself (no calls): is there an
    // artwork method on the item that resolves the block internally?
    var itemMethods = {};
    ['artwork', 'nowPlayingArtwork', 'artworkData', 'loadArtwork', 'requestArtwork'].forEach(function (name) {
      try { itemMethods[name] = typeof item[name]; } catch (e) { itemMethods[name] = 'error'; }
    });
    function pngBase64(cgImage) {
      var rep = $.NSBitmapImageRep.alloc.initWithCGImage(cgImage);
      var data = rep.representationUsingTypeProperties(4, $.NSDictionary.dictionary);
      return data.base64EncodedStringWithOptions(0).js;
    }
    function tiffBase64(cgImage) {
      var img = $.NSImage.alloc.initWithCGImageSize(cgImage, { width: 600, height: 600 });
      var tiff = img.TIFFRepresentation;
      return tiff.base64EncodedStringWithOptions(0).js;
    }
    function imageBase64(value) {
      if (!value) return { converted: 'null-value' };
      try { var b = value.base64EncodedStringWithOptions(0).js; if (b) return { converted: 'nsdata len ' + b.length }; } catch (e) {}
      try { var b2 = pngBase64(value); if (b2) return { converted: 'png len ' + b2.length }; } catch (e) {}
      try { var b3 = tiffBase64(value); if (b3) return { converted: 'tiff len ' + b3.length }; } catch (e) {}
      return { converted: 'none' };
    }
    function describeResult(value) {
      var d = {};
      try { d.typeofResult = typeof value; } catch (e) { d.typeofResult = 'error'; }
      try { d.string = value ? String(value).slice(0, 120) : 'null'; } catch (e) { d.string = 'error'; }
      var conv = imageBase64(value);
      d.converted = conv.converted;
      return d;
    }
    var calls = {};
    if (typeof art === 'function') {
      try {
        var r0 = art();
        calls.noArg = describeResult(r0);
      } catch (e) { calls.noArg = { error: String(e) }; }
      if (!calls.noArg.converted || calls.noArg.converted === 'none') {
        try {
          var r1 = art({ width: 600, height: 600 });
          calls.withSize = describeResult(r1);
        } catch (e) { calls.withSize = { error: String(e) }; }
      }
    } else {
      calls.note = 'art is not a function (typeof ' + (typeof art) + ')';
    }
    return JSON.stringify({
      title: str('kMRMediaRemoteNowPlayingInfoTitle'),
      artist: str('kMRMediaRemoteNowPlayingInfoArtist'),
      artworkPresent: !!art,
      typeofArt: (function () { try { return typeof art; } catch (e) { return 'error'; } })(),
      itemMethods: itemMethods,
      calls: calls
    });
  } catch (e) {
    return JSON.stringify({ error: String(e) });
  }
}
